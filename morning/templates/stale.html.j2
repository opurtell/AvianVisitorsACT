<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Dawn Chorus · {{ today.strftime('%-d %B %Y') }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>
<div class="sheet">
<header class="masthead">
  <div class="ears"><span>No edition</span><span></span><span><a href="archive.html">Archive</a></span></div>
  <h1>The Dawn Chorus</h1>
  <p class="motto">All the birds fit to print</p>
  <div class="dateline"><span>{{ today.strftime('%A %-d %B %Y') }}</span></div>
</header>
<main>
  <article class="lead">
    <h2>No birds reached the paper this morning</h2>
    {% if latest %}
    <p class="standfirst">The last call the station sent in was {{ latest|clock }} on {{ latest.strftime('%A %-d %B') }}. There's no edition until it's listening again.</p>
    {% else %}
    <p class="standfirst">The station hasn't sent in any calls. There's no edition until it's listening again.</p>
    {% endif %}
    {% if last_edition %}
    <p><a href="{{ last_edition }}.html">Read the last edition</a> or browse the <a href="archive.html">archive</a>.</p>
    {% endif %}
  </article>
</main>
</div>
</body>
</html>
